# ============================================
# ContainerLab GUI - 環境変数
# ============================================
# cp .env.example .env して値を入力
# ⚠️ .env はGitにコミットしないこと
# ※ .env は **オプション** です (未配置でもデフォルト値で起動可能)

# ---- Aruba AOS-CX SSH認証（vrnetlabデフォルト） ----
AOSCX_SSH_USER=admin
AOSCX_SSH_PASS=admin

# ---- ContainerLab 管理ネットワーク (オプション) ----
# 同一ホスト上の他の Docker Compose プロジェクト (例: 172.20.0.0/16) と
# サブネットが衝突する場合に空きレンジを指定する。
# 未設定なら containerlab のデフォルト (172.20.20.0/24) が使われる。
#CLAB_MGMT_IPV4_SUBNET=172.30.30.0/24
#CLAB_MGMT_IPV6_SUBNET=3fff:172:30:30::/64
#CLAB_MGMT_NETWORK=clab
